APP_NAME=MARSA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marsa
DB_USERNAME=root
DB_PASSWORD=your_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Drivers: smtp (real delivery), log (writes to storage/logs/laravel.log only), array (testing).
#
# Gmail-style (STARTTLS): MAIL_PORT=587, leave MAIL_SCHEME empty (Laravel uses smtp + STARTTLS).
# SSL: MAIL_PORT=465 — Laravel defaults scheme to smtps for port 465.
# Mailtrap / similar: use the host, port, username, and password from your inbox provider.
# DreamHost: MAIL_HOST=smtp.dreamhost.com, MAIL_PORT=587, MAIL_USERNAME=full address, MAIL_PASSWORD=mailbox password.
# Put real credentials only in .env (never commit). Quote passwords with @ or #: MAIL_PASSWORD="your_password"
#
MAIL_MAILER=smtp
MAIL_SCHEME=null
# Do not set MAIL_URL to blank — omit it unless you use a full DSN (smtp://…).
MAIL_HOST=smtp.dreamhost.com
MAIL_PORT=587
MAIL_USERNAME=you@yourdomain.com
MAIL_PASSWORD=your_mailbox_password

MAIL_FROM_ADDRESS="info@marsafounders.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: hostname sent in EHLO (some providers require it to match your domain)
# MAIL_EHLO_DOMAIN=marsafounders.com

# Signed URL lifetime for email verification links (minutes)
AUTH_VERIFICATION_EXPIRE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3001

# PDF export (DomPDF) — enable PHP extension=gd in php.ini to embed logo/watermark PNGs.
# Without GD, exports still work but omit embedded logo images.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
